{% set fwutils = TRUE %}
{% set usejquery = FALSE %}
{% set usebootbox = FALSE %}

{% extends '@content/page.twig' %}

{% import '@util/formmacro.twig' as f %}

{%set url = bean.type == 'js' or bean.type = 'js' %}

{% block onload %}
    document.getElementById('more').addEventListener('click', function(e){
        fwdom.stop(e);
        const mrow = $('#mrow');
        mrow.before($('#example').clone());
        const pr = $mrow.prev();
        pr.querySelectorAll('input').forEach(function(inp){
            inp.value = '';
        });
        pr.querySelectorAll('option').forEach(function(opt){
            opt.selected = false;
        });
        fwdom.on('.delb', 'click', function(e){
            framework.dodelbean(e, this, '{{constant('Config\\Framework::ROLE')}}');
        }, pr);
    });
{% endblock onload %}

{% block headerbody %}
    <h1>Config Item "{{bean.name}}"</h1>
{% endblock headerbody %}

{% block main %}
    <section class="row">
        <article class="offset-md-1 col">
            {% include '@util/message.twig' %}
            <form action="#" method="post" id="uform" data-parsley-validate>
                {{f.hidden({name: 'bean', value: bean.id})}}
                {{bean.guard|raw}}
                <fieldset>
                    <legend>Details</legend>
                    {{f.text({ label: 'Value', id: 'vl', name: 'value', value: bean.value})}}
                    {{f.select({label : 'Type', id: 'typ', name: 'type', required: TRUE, selected: bean.type,
                        options: [
                            { value: '',  text: '&mdash; Pick a Type &mdash;' },
                            { value: 'boolean', text: 'boolean' },
                            { value: 'css', text: 'css' },
                            { value: 'integer', text: 'integer' },
                            { value: 'js', text: 'js' },
                            { value: 'string', text: 'string' },
                            { value: 'json', text: 'json' },
                            { value: 'xml', text: 'xml' },
                        ]
                    })}}
                    {{f.checkbox({group: TRUE, names: ['Fixed'], values:[1], check: [bean.fized], labels: ['Defer']})}}
                    {{f.checkbox({group: TRUE, names: ['Local'], values:[1], check: [bean.local], labels: ['Async']})}}
                    {{f.text({ label: 'Integrity', id: 'it', name: 'integrity', value: bean.integrity, disabled : {{url ? 0 : 1}},
                        help: 'The hashcode value for the integrity attribute for URLs or leave empty'})}}
                    {{f.text({ label: 'CrossOrigin', id: 'co', name: 'crossorigin', value: bean.crossorigin, disabled : {{url ? 0 : 1}},
                        help:'Valid values are <i>anonymous</i> or <i>use-credentials</i> or leave empty'})}}
                    {{f.text({ label: 'ReferrerPolicy', id: 'rp', name: 'refpolicy', value: bean.crossorigin, disabled : {{url ? 0 : 1}},
                        help:'Check the HTML spec for valid values or leave empty'})}}
                    {{f.checkbox({group: TRUE, names: ['Defer'], values:[1], check: [bean.defer], labels: ['Defer']}, disabled : {{url ? 0 : 1}},)}}
                    {{f.checkbox({group: TRUE, names: ['Async'], values:[1], check: [bean.async], labels: ['Async']}, disabled : {{url ? 0 : 1}},)}}

                </fieldset>
                <button class="btn btn-primary btn-lg" type="submit">Save</button>
            </form>
        </article>
    </section>
{% endblock main %}

{% block pagefooter %}
{% endblock pagefooter %}
